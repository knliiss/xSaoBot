# Copy to .env and fill values for local development
BOT_TOKEN=your_bot_token_here
BOT_NAME=sao_telegram_bot
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
MANAGEMENT_PORT=8080

# Postgres credentials used by docker-compose
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sao_db

# Mongo
SPRING_DATA_MONGODB_URI=mongodb://mongo:mongo@mongo:27017/sao_bot_mongo?authSource=admin

